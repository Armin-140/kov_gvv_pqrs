Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 12
      Reference Frame: <Fixed Frame>
      Color: 160; 160; 164
      Alpha: 0.5
    - Class: rviz_default_plugins/Path
      Name: Trajectory
      Enabled: true
      Color: 25; 255; 0
      Line Style: Billboards
      Line Width: 0.05
      Alpha: 1
      Buffer Length: 1
      Topic:
        Value: /trajectory
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Pose
      Name: TargetPose
      Enabled: true
      Shape: Arrow
      Color: 255; 25; 0
      Alpha: 1
      Shaft Length: 0.6
      Shaft Radius: 0.08
      Head Length: 0.3
      Head Radius: 0.16
      Topic:
        Value: /target_pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 60
      X: 0
      Y: 0
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
  Hide Left Dock: false
  Hide Right Dock: true
